<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_glass">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_quick" android:textColor="@color/widget_text"
        android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_add_note" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:minHeight="48dp" android:text="✎ 新笔记" android:textColor="@color/widget_text" android:textSize="14sp" android:maxLines="2" />
        <TextView android:id="@+id/widget_add_todo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:minHeight="48dp" android:text="＋ 待办" android:textColor="@color/widget_text" android:textSize="14sp" android:maxLines="2" />
        <TextView android:id="@+id/widget_add_ai" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:minHeight="48dp" android:text="✦ AI 创建" android:textColor="@color/widget_text" android:textSize="14sp" android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
