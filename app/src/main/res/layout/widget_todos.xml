<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_glass">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_todos" android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="轻触标题打开 · 轻触圆圈完成" android:textColor="@color/widget_secondary" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
