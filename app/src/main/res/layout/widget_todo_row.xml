<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_check" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textSize="24sp" android:textColor="@color/widget_text" />
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
    <TextView android:id="@+id/widget_priority" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_secondary" />
</LinearLayout>
